*.o
*.d
*.a
.vscode
urfd.*
tcd.*
urfd
inicheck
dbutil
tcd

# Docker runtime
docker/logs/*
!docker/logs/.gitkeep

# Allow docker service unit, nginx config and .example templates (override the urfd.* / tcd.* rules above)
!docker/urfd.service
!docker/nginx/urfd.conf
!docker/config/urfd.ini.example
!docker/config/urfd.blacklist.example
!docker/config/urfd.whitelist.example
!docker/config/urfd.interlink.example
!docker/config/tcd.ini.example

# dashboard config has no wildcard rule above, so explicitly ignore the real file only
docker/config/dashboard-config.inc.php

# Local user documentation — not for the public repo
INSTRUCTIONS.md
INSTRUCTIONS-FACEBOOK.txt
