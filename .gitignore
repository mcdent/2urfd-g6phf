*.o
*.d
*.a
.vscode
urfd.*
tcd.*
urfd
inicheck
dbutil
tcd

# Docker runtime
docker/logs/*
!docker/logs/.gitkeep

# Allow docker config files and service unit (override the urfd.* / tcd.* rules above)
!docker/urfd.service
!docker/config/urfd.ini
!docker/config/urfd.blacklist
!docker/config/urfd.whitelist
!docker/config/urfd.interlink
!docker/config/tcd.ini
